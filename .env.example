# copy to .env (git-ignored). Start ../docker-dependencies first (MongoDB + RabbitMQ).
NODE_ENV=development
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000

# must equal the secret User Service signs tokens with (>= 32 chars)
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

NOTIFICATION_SERVICE_PORT=3002

# must match ../docker-dependencies/.env
NOTIFICATION_SERVICE_DB=notification_db
NOTIFICATION_SERVICE_DB_USER=notification_service_app
NOTIFICATION_SERVICE_DB_PASSWORD=local_notification_service_password

RABBITMQ_USER=harnkan
RABBITMQ_PASSWORD=harnkan
RABBITMQ_EXCHANGE=harnkan.events

# used when the app runs on the host (docker compose points the container at mongodb / rabbitmq itself)
MONGO_URI=mongodb://notification_service_app:local_notification_service_password@localhost:27017/notification_db
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
