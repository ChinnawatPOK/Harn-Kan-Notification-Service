# For `npm run dev` on your Mac, against the shared harnkan MongoDB and
# RabbitMQ (start them with: cd .. && docker compose up -d mongodb rabbitmq).
# Copy the passwords and JWT_SECRET from ../.env.
PORT=3002
MONGO_URI=mongodb://notification_service_app:<NOTIFICATION_SERVICE_DB_PASSWORD>@localhost:27017/notification_db
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=harnkan
RABBITMQ_PASSWORD=<RABBITMQ_PASSWORD>
# Must match the secret User Service signs JWTs with
JWT_SECRET=<JWT_SECRET>
