NODE_ENV=development
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000

# JWTs
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=1d

USER_SERVICE_PORT=3000
NOTIFICATION_SERVICE_PORT=3002

# MongoDB instance
MONGO_PORT=27017
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=local_root_password

# db 
USER_SERVICE_DB=user_service
USER_SERVICE_DB_USER=user_service_app
USER_SERVICE_DB_PASSWORD=local_user_service_password

NOTIFICATION_SERVICE_DB=notification_db
NOTIFICATION_SERVICE_DB_USER=notification_service_app
NOTIFICATION_SERVICE_DB_PASSWORD=local_notification_service_password

# RabbitMQ
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=harnkan
RABBITMQ_PASSWORD=local_rabbitmq_password
RABBITMQ_EXCHANGE=harnkan.events
