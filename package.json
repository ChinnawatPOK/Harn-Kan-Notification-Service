{
  "name": "harn-kan-notification-service",
  "version": "1.0.0",
  "description": "Harn-Kan Notification Service: user category preferences and deal.created fan-out",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --runInBand",
    "publish:deal": "tsx --env-file=../.env scripts/publish-deal-created.ts",
    "token": "tsx --env-file=../.env scripts/make-token.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChinnawatPOK/Harn-Kan-Notification-Service.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ChinnawatPOK/Harn-Kan-Notification-Service/issues"
  },
  "homepage": "https://github.com/ChinnawatPOK/Harn-Kan-Notification-Service#readme",
  "dependencies": {
    "amqplib": "^2.2.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20.6"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "testTimeout": 60000
  }
}
